<section class="meet">
    {% if section.settings.owner_image %}
      <div class="img-wrap">
        {{ section.settings.owner_image | image_url: width: 500 | image_tag }}
      </div>
    {% endif %}
    <div class="text-wrap">
      <h2>{{ section.settings.owner_heading }}</h2>
      <p>{{ section.settings.owner_text }}</p>
    </div>
</section>

{% stylesheet %}
  .meet {
    display: flex;
    column-gap: 32px;
    margin-bottom: 64px;

    .img-wrap {
      aspect-ratio: 1/1;
      overflow: hidden;
      border-radius: 24px;

      @media (max-width: 959px) {
        align-self: center;
      }
    }

    h2 {
      margin-bottom: 16px;
    }

    @media (min-width: 960px) {
      .img-wrap {
        flex: 0 0 50%;
        max-width: 500px;
      }
    }

    @media (max-width: 959px) {
      flex-direction: column;
      row-gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Meet The Owner",
  "settings": [
    {
      "type": "image_picker",
      "id": "owner_image",
      "label": "Owner Image"
    },
    {
      "type": "text",
      "id": "owner_heading",
      "label": "Owner Heading",
      "default": "Meet The Owner"
    },
    {
      "type": "textarea",
      "id": "owner_text",
      "label": "Owner Text",
      "default": "Hi! My name is Christina, aka Farmer Stina. I'm the founder, farmer, and designer behind Sleepy Bee Gardens.\n\nI've always had a deep passion for local farms, dreaming one day of having my own. In college I helped small local farms in Santa Barbara, CA get their products to local farmers markets and to strategically partner with UCSB to supply local organic food to the dining commons. Now I'm passionate about bringing local, seasonal, and organic cut flowers to my CO community. Flowers have always been my first love, dreaming of retiring and owning a cute little florist stand one day.\n\nI supply fresh flower products like wrapped bouquets and custom arrangements as well as dried flower products like dried bouquets, wreaths, and smudge sticks in the off-season. I do garden consulting and events like elopements, weddings, and showers. If you're looking for sustainable and organic options - you've come to the right place. We are 100% flower foam/ pesticide/ herbicide/ insecticide FREE."
    }
  ],
  "presets": [
    {
      "name": "Meet The Owner"
    }
  ]
}
{% endschema %}