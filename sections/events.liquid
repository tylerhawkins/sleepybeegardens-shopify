{%- assign events_blog = blogs[section.settings.blog] -%}

<section class="events-wrap full-width">
    <div class="events-calendar-wrap">
        <div id="events-calendar"></div>
    </div>

    {%- if events_blog -%}
        {%- assign has_events = false -%}
        {%- assign sorted_events = events_blog.articles | reverse -%}

        <div class="events-list">
            {%- for article in sorted_events -%}
                {%- assign event_date = article.metafields.custom.event_date.value -%}
                {%- assign event_date_ts = event_date | date: '%s' | plus: 0 -%}
                {%- if event_date_ts -%}
                    {%- assign has_events = true -%}
                    <div class="event-card" data-date="{{ event_date | date: '%s' }}">
                        {%- if article.image -%}
                            <div class="event-card__image">
                                {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                            </div>
                        {%- endif -%}
                        <div class="event-card__content">
                            <div class="event-card__title">
                                <p class="event-card__date">{{ event_date | date: '%A, %B %e, %Y' }}</p>
                                <h2>{{ article.title }}</h2>
                            </div>
                            {%- if article.excerpt.size > 0 -%}
                                <p>{{ article.excerpt }}</p>
                            {%- endif -%}
                            {%- if article.content -%}
                                <div class="event-card__body">{{ article.content }}</div>
                            {%- endif -%}
                        </div>
                    </div>
                {%- endif -%}
            {%- endfor -%}
        </div>

        {%- unless has_events -%}
            <p class="events-empty">No upcoming events. Check back soon!</p>
        {%- endunless -%}
    {%- endif -%}
</section>

<script>
    window.shopifyEvents = [
        {%- for article in events_blog.articles -%}
            {%- assign event_date = article.metafields.custom.event_date.value -%}
            {
                "title": {{ article.title | json }},
                "start": {{ event_date | json }},
                "url": {{ article.url | json }},
                "description": {{ article.content | json }},
                "backgroundColor": "#698333"
            }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
    ];
</script>

{% javascript %}
    document.addEventListener('DOMContentLoaded', function() {
        // Sort event cards by data-date ascending
        const list = document.querySelector('.events-list');
        if (list) {
            const cards = Array.from(list.querySelectorAll('.event-card'));
            cards.sort((a, b) => a.dataset.date - b.dataset.date);
            cards.forEach(card => list.appendChild(card));
            list.style.visibility = 'visible';
        }

        // Init calendar
        if (window.innerWidth >= 1280) {
            var calendarEl = document.getElementById('events-calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                height: 'auto',
                events: window.shopifyEvents,
                eventDidMount: function(arg) {
                    if(arg.event.extendedProps.description) {
                        arg.el.querySelector('.fc-event-title-container').insertAdjacentHTML(
                            'afterend',
                            `<div class="fc-event-info">${arg.event.extendedProps.description}</div>`
                        );
                    }
                },
            });

            calendar.render();
        }
    });
{% endjavascript %}

{% stylesheet %}
    .fc-scroller-harness {
        overflow: visible !important;
    }

    .fc-day:hover {
        z-index: 10;
    }

    .fc-event-title {
        padding: 0 1px;
        white-space: normal;
    }

    .fc-event-main-frame {
        position: relative;

        .fc-event-info {
            display: none;
            position: absolute;
            top: calc(100% + 4px);
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            background-color: var(--color-white);
            color: var(--color-foreground);
            border: 2px solid var(--color-green);
            padding: 10px;
            border-radius: 4px;

            &::before {
                content: '';
                display: block;
                height: 4px;
                top: -6px;
                position: absolute;
                width: 100%;
                left: 0;
            }
        }

        &:hover {
            .fc-event-info {
                display: block;
            }
        }
    } 

    .events-wrap {
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        padding: 0 24px;

        h1 {
            margin-bottom: 40px;
        }
    }

    .events-calendar-wrap {
        --fc-today-bg-color: #E9AA6CA6;
        --fc-button-bg-color: var(--color-orange);
        --fc-button-hover-bg-color: var(--color-orange-2);
        --fc-button-border-color: #ddd;
        --fc-button-hover-border-color: #ddd;
        --fc-button-active-bg-color: var(--color-orange-2);
        --fc-button-active-border-color: #ddd;
        --fc-event-border-color: var(--color-green);
        margin-bottom: 48px;

        @media (max-width: 1279px) {
            display: none;
        }
    }

    .events-list {
        display: flex;
        flex-direction: column;
        gap: 40px;
        visibility: hidden;
    }

    .event-card {
        gap: 32px;
        align-items: start;
        
        &:not(:last-child) {
            padding-bottom: 40px;
            border-bottom: 2px solid #d3d3d3;
        }

        @media (min-width: 521px) {
            display: grid;
            grid-template-columns: 100px 1fr;
        }

        @media (max-width: 520px) {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .event-card__image {
            border-radius: 12px;
            overflow: hidden;
            aspect-ratio: 1/1;

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }

        .event-card__content {
            display: flex;
            flex-direction: column;
            gap: 12px;

            @media (max-width: 520px) {
                width: 100%;
            }
        }

        .event-card__date {
            display: inline-block;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            background-color: var(--color-green);
            color: var(--color-white);
            border-radius: 8px;
            padding: 4px 8px;
            margin-bottom: 4px;
        }

        h2 {
            margin: 0;
        }

        p {
            margin: 0;
        }
    }

    .events-empty {
        color: #666;
        font-style: italic;
    }
{% endstylesheet %}

{% schema %}
{
    "name": "Events",
    "settings": [
        {
            "type": "blog",
            "id": "blog",
            "label": "Events blog"
        }
    ]
}
{% endschema %}
