<section class="about-section">
    {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.image -%}
        <div class="about-image">
            {{ section.settings.image | image_url: width: 800 | image_tag }}
        </div>
    {%- endif -%}

    {%- if section.settings.content != blank -%}
        <div class="about-content">{{ section.settings.content }}</div>
    {%- endif -%}
</section>

{% stylesheet %}
    .about-section {
        margin-bottom: 48px;

        h2 {
            margin-bottom: 24px;
        }
    }

    .about-image {
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 24px;

        img {
            width: 100%;
            height: auto;
            display: block;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "About Section",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content"
        }
    ],
    "presets": [
        {
            "name": "About Section"
        }
    ]
}
{% endschema %}
