{% comment %}
This section is used in the product template to render product page with
media, content, and add-to-cart form.

https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-page-wrap">
    <h1 class="mobile-title">{{ product.title }}</h1>
    <div class="product-images">
        <div class="swiper swiper-main product-images-swiper">
            <div class="swiper-wrapper">
                {% for media in product.media %}
                    <div class="swiper-slide" data-media-id="{{ media.id }}">
                        {% case media.media_type %}
                            {% when 'image' %}
                                {% render 'image', class: 'product-image', image: media %}
                            {% when 'video' %}
                                {{ media | video_tag: class: 'product-video', autoplay: false, loop: true, controls: true }}
                            {% when 'external_video' %}
                                {{ media | external_video_tag: class: 'product-video' }}
                        {% endcase %}
                    </div>
                {% endfor %}
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
        <div class="swiper swiper-thumb product-images-thumb-swiper" thumbsSlider="">
            <div class="swiper-wrapper">
                {% for media in product.media %}
                    <div class="swiper-slide">
                        {% if media.media_type == 'image' %}
                            {% render 'image', class: 'product-image-thumb', image: media %}
                        {% else %}
                            {% render 'image', class: 'product-image-thumb', image: media.preview_image %}
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Initialize Swiper -->
        <script>
            var thumbSwiper = new Swiper(".product-images-thumb-swiper", {
                loop: true,
                spaceBetween: 12,
                slidesPerView: 4,
                freeMode: true,
                watchSlidesProgress: true,
            });
            var swiper = new Swiper(".product-images-swiper", {
                loop: true,
                spaceBetween: 12,
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
                thumbs: {
                    swiper: thumbSwiper,
                },
            });
        </script>
    </div>
    <div class="product-content">
        {% assign current_variant = product.selected_or_first_available_variant %}

        <h1>{{ product.title }}</h1>
        
        <p class="product-price" id="product-price">{{ current_variant.price | money }}</p>

        <div class="product-description">
            {{ product.description }}
        </div>

        {% if product.metafields.custom.show_water_tip == true %}
            <p class="tip">Monitor water closely! Fresh flowers drink much more water than store-bought flowers.</p>
        {% endif %}

        {% form 'product', product %}
            {% if product.variants.size > 1 %}
                <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">
                <div class="variant-tiles">
                    {% for variant in product.variants %}
                        <button
                            type="button"
                            class="variant-tile {% if variant == current_variant %}is-selected{% endif %}"
                            data-variant-id="{{ variant.id }}"
                            data-media-id="{{ variant.featured_media.id }}"
                            data-price="{{ variant.price | money }}"
                        >
                            {{ variant.title }}
                        </button>
                    {% endfor %}
                </div>
            {% else %}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
            {% endif %}
            
            <div class="atc-wrap">
                <div class="quantity-wrap">
                    <button type="button" class="quantity-btn decrement" onclick="this.nextElementSibling.stepDown()">-</button>
                    <input type="number" name="quantity" min="1" value="1" />
                    <button type="button" class="quantity-btn increment" onclick="this.previousElementSibling.stepUp()">+</button>
                </div>
                <button class="button">Add to Cart</button>
                {% comment %} {{ form | payment_button }} {% endcomment %}
            </div>
        {% endform %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var tiles = document.querySelectorAll('.variant-tile');
                var variantInput = document.getElementById('variant-id');
                var priceEl = document.getElementById('product-price');

                tiles.forEach(function(tile) {
                    tile.addEventListener('click', function() {
                        // Update selected state
                        tiles.forEach(t => t.classList.remove('is-selected'));
                        this.classList.add('is-selected');

                        // Update hidden input
                        if (variantInput) variantInput.value = this.dataset.variantId;

                        // Update price
                        if (priceEl && this.dataset.price) priceEl.textContent = this.dataset.price;

                        // Slide to variant media
                        var mediaId = this.dataset.mediaId;
                        if (mediaId) {
                            var slides = document.querySelectorAll('.product-images-swiper .swiper-slide[data-media-id]');
                            var index = Array.from(slides).findIndex(s => s.dataset.mediaId === mediaId);
                            if (index !== -1) swiper.slideToLoop(index);
                        }
                    });
                });
            });
        </script>
    </div>
</div>

<div class="pdp-callout full-width">
    <h3>All of our flowers are grown with love.</h3>
</div>

{% stylesheet %}
.pdp-callout {
    height: 20vh;
    background-image: var(--bg-sbg);
    background-size: cover;
    background-position: center center;
    padding: 48px;
    margin: 48px 0;
    display: flex;
    justify-content: center;
    align-items: center;
}

.product-page-wrap {
    display: flex;
    column-gap: 48px;

    @media (max-width: 759px) {
        flex-direction: column;
        row-gap: 16px;
    }

    .mobile-title {
        display: none;
        font-size: 1.5em;

        @media (max-width: 759px) {
            display: block;
        }
    }
    

    .product-images {
        min-width: 0; /* fixes grid blowout */

        @media (min-width: 760px) {
            flex: 0 0 40%;
        }

        .product-image img,
        .product-video {
            border-radius: 24px;
            width: 100%;
            height: auto;
        }

        .product-image-thumb {
            @media (max-width: 759px) {
                aspect-ratio: 3 / 2;
            }

            img {
                border-radius: 8px;

                @media (max-width: 759px) {
                    max-height: 100%;
                }
            }
        }
    }

    .product-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    h1 {
        @media (max-width: 759px) {
            display: none;
        }
    }

    .product-price {
        font-size: 20px;
        margin: 0;
    }

    .product-description {
        margin: 0;
    }

    .shopify-product-form {
        display: flex;
        flex-direction: column;
        row-gap: 24px;

        @media (min-width: 760px) {
            #variant-select {
                align-self: flex-start;
                width: auto;
            }
        }
    }

    .variant-tiles {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    .variant-tile {
        padding: 8px 16px;
        border: 2px solid var(--color-blue);
        border-radius: 24px;
        background: none;
        cursor: pointer;
        font-family: inherit;
        font-size: 14px;
        transition: all 0.2s ease;
        color: var(--color-blue);

        &:hover {
            border-color: var(--color-blue);
            color: var(--color-blue);
        }

        &:not(.is-selected) {
            opacity: 0.8;

            &:hover {
                opacity: 1;
            }
        }

        &.is-selected {
            border-color: var(--color-blue);
            background: var(--color-blue);
            color: var(--color-white);
        }
    }
}
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.product",
    "settings": [],
    "disabled_on": {
        "groups": ["header", "footer"]
    }
}
{% endschema %}
