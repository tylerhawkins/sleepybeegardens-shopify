<section class="gallery-wrap full-width">
    <div class="title-wrap">
        {% if section.settings.hero_image %}
            {{ section.settings.hero_image | image_url: width: 1920 | image_tag: fetchpriority: 'high', loading: 'eager', class: 'title-wrap__bg' }}
        {% endif %}
        <h1>{{ page.title }}</h1>
    </div>

    {%- if section.settings.album_title != blank -%}
        <h2 class="gallery-album-title">{{ section.settings.album_title }}</h2>
    {%- endif -%}

    {%- if section.settings.album_description != blank -%}
        <p class="gallery-album-desc">{{ section.settings.album_description }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
        <div class="gallery-grid grid" id="gallery-grid-{{ section.id }}">
            {%- assign ratios = '1/1,4/3,3/4,16/9,2/3' | split: ',' -%}
            {%- for block in section.blocks -%}
                {%- if block.settings.image -%}
                    {%- assign ratio_index = forloop.index0 | modulo: ratios.size -%}
                    {%- assign ratio = ratios[ratio_index] -%}
                    <div class="gallery-item grid-item" style="aspect-ratio: {{ ratio }}" {{ block.shopify_attributes }}>
                        {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.alt }}
                    </div>
                {%- endif -%}
            {%- endfor -%}
        </div>
    {%- else -%}
        <p class="gallery-empty">No images yet. Add images in the theme editor.</p>
    {%- endif -%}

    <div class="gallery-lightbox" id="gallery-lightbox-{{ section.id }}">
        <div class="gallery-lightbox__close" id="gallery-close-{{ section.id }}">{{ 'icon-close.svg' | inline_asset_content }}</div>
        <div class="swiper gallery-lightbox-swiper">
            <div class="swiper-wrapper" id="gallery-swiper-wrapper-{{ section.id }}"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Init Masonry after all images have loaded so heights are correct
        const msnry = new Masonry('#gallery-grid-{{ section.id }}', {
            itemSelector: '.gallery-item',
            columnWidth: '.gallery-item',
            percentPosition: true,
            gutter: 0
        });

        // Re-layout after images load
        imagesLoaded('#gallery-grid-{{ section.id }}', () => msnry.layout());

        const items = Array.from(document.querySelectorAll('#gallery-grid-{{ section.id }} .gallery-item img'));
        const lightbox = document.getElementById('gallery-lightbox-{{ section.id }}');
        const wrapper = document.getElementById('gallery-swiper-wrapper-{{ section.id }}');

        // Build swiper slides from gallery images
        items.forEach(img => {
            const slide = document.createElement('div');
            slide.className = 'swiper-slide';
            const fullImg = document.createElement('img');
            fullImg.src = img.src.replace(/&width=\d+/, '&width=1600');
            fullImg.alt = img.alt;
            slide.appendChild(fullImg);
            wrapper.appendChild(slide);
        });

        const swiperEl = lightbox.querySelector('.gallery-lightbox-swiper');

        const swiper = new Swiper(swiperEl, {
            loop: true,
            keyboard: { enabled: true },
            navigation: {
                nextEl: swiperEl.querySelector('.swiper-button-next'),
                prevEl: swiperEl.querySelector('.swiper-button-prev'),
            },
        });

        function open(index) {
            lightbox.classList.add('is-open');
            document.body.style.overflow = 'hidden';
            swiper.slideToLoop(index, 0);
        }

        function close() {
            lightbox.classList.remove('is-open');
            document.body.style.overflow = '';
        }

        items.forEach((img, i) => img.parentElement.addEventListener('click', () => open(i)));
        document.getElementById('gallery-close-{{ section.id }}').addEventListener('click', close);
        lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
        document.addEventListener('keydown', (e) => {
            if (lightbox.classList.contains('is-open') && e.key === 'Escape') close();
        });
    });
</script>

{% stylesheet %}
    .gallery-wrap {
        margin-bottom: 48px;
    }

    .gallery-wrap .title-wrap {
        margin-left: -24px;
        margin-right: -24px;

        @media (max-width: 959px) {
            margin-left: -16px;
            margin-right: -16px;
        }

        @media (max-width: 768px) {
            height: 20vh;
        }

        @media (max-width: 479px) {
            width: calc(100% + 32px);
            height: auto;
            aspect-ratio: 2/1;
        }
    }

    .gallery-album-title {
        margin: 24px -24px 88px;
        padding: 24px;
        font-size: 48px;
        text-align: center;
        background-color: var(--color-green-3);
        color: var(--color-white);
        position: relative;

        &::before {
            content: '';
            display: block;
            height: 40px;
            background-color: var(--color-green-3);
            -webkit-clip-path: url(#solid-waves-angle-top-up);
            clip-path: url(#solid-waves-angle-top-up);
            position: absolute;
            bottom: 100%;
            left: 0;
            right: 0;
            z-index: 10;
        }

        &::after {
            content: '';
            display: block;
            height: 40px;
            background-color: var(--color-green-3);
            -webkit-clip-path: url(#solid-waves-angle-bottom-up);
            clip-path: url(#solid-waves-angle-bottom-up);
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 10;
        }
    }

    .shopify-section + .shopify-section .gallery-wrap .title-wrap {
        display: none;
    }

    .gallery-grid {
        margin: 0 -8px;
    }

    .gallery-item {
        position: relative;
        float: left;
        width: calc(25% - 16px);
        margin: 0 8px 16px;
        overflow: hidden;
        border-radius: 12px;
        cursor: pointer;

        @media (max-width: 959px) {
            width: calc(50% - 16px);
        }

        @media (max-width: 599px) {
            width: calc(100% - 16px);
        }

        img {
            width: 100%;
            height: 100%;
            display: block;
            transition: transform 0.3s ease;
            object-fit: cover;
        }

        &:hover img {
            transform: scale(1.05);
        }
    }

    .gallery-empty {
        color: #666;
        font-style: italic;
    }

    /* Lightbox */
    .gallery-lightbox {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.9);
        z-index: 1000;

        &.is-open {
            display: block;
        }

        .gallery-lightbox__close {
            position: absolute;
            top: 24px;
            right: 24px;
            color: white;
            cursor: pointer;
            z-index: 10;
            svg { width: 32px; height: 32px; }
        }

        .swiper {
            width: 100%;
            height: 100%;
        }

        .swiper-slide {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        img {
            max-width: 90vw;
            max-height: 90vh;
            object-fit: contain;
            border-radius: 4px;
            height: auto;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "Gallery",
    "settings": [
        {
            "type": "text",
            "id": "album_title",
            "label": "Album Title"
        },
        {
            "type": "image_picker",
            "id": "hero_image",
            "label": "Hero image"
        },
        {
            "type": "text",
            "id": "album_description",
            "label": "Album Description"
        }
    ],
    "blocks": [
        {
            "type": "image_picker",
            "name": "Image",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "alt",
                    "label": "Alt Text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Gallery"
        }
    ]
}
{% endschema %}
